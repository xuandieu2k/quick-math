<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_border_dialog"
        android:padding="@dimen/dp_8">

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            android:id="@+id/tvTitle"
            style="@style/TextWhiteSp40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/language"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:layout_marginVertical="@dimen/dp_16"
            android:background="@drawable/bg_border_dialog"
            android:backgroundTint="#127475"
            android:orientation="vertical"
            android:padding="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintHeight_max="@dimen/dp_120"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:itemCount="4"
                tools:listitem="@layout/item_language" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/clContent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginVertical="@dimen/dp_4"
            android:gravity="center">

            <com.dhug.quick_math.base.wiget.AppButtonBold
                android:id="@+id/btnCancel"
                style="@style/TextWhiteCommon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_weight="1"
                android:background="@drawable/ripple_button"
                android:paddingVertical="@dimen/dp_8"
                android:text="@string/common_cancel" />

            <com.dhug.quick_math.base.wiget.AppButtonBold
                android:id="@+id/btnConfirm"
                style="@style/TextWhiteCommon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_weight="1"
                android:background="@drawable/ripple_button"
                android:paddingVertical="@dimen/dp_8"
                android:text="@string/common_confirm" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>