<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/colorBackground"
    tools:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_40"
        android:background="@drawable/bg_board"
        android:layout_marginBottom="@dimen/dp_24"
        app:layout_constraintBottom_toTopOf="@+id/clText">

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            style="@style/TextWhiteSp40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"/>

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            android:id="@+id/tv"
            style="@style/TextWhiteSp40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:text="-"/>

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            style="@style/TextWhiteSp40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"/>

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            style="@style/TextWhiteSp40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:text="=" />

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            android:id="@+id/tvAnswer"
            style="@style/TextWhiteSp40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="?" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            android:id="@+id/tvQuick"
            style="@style/TextAutoSp48"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            style="@style/TextAutoSp48"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/math"

            app:layout_constraintLeft_toRightOf="@+id/tvQuick"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/tvQuick" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <ProgressBar
        android:id="@+id/pbLoading"
        app:layout_constraintTop_toBottomOf="@id/clText"
        app:layout_constraintBottom_toTopOf="@id/llLogo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"/>

    <LinearLayout
        android:id="@+id/llLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_32"
        android:layout_marginBottom="@dimen/dp_32"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.dhug.quick_math.base.wiget.AppTextViewBold
            style="@style/TextAutoCommon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/provide_by" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_8"
            android:src="@drawable/logo_company_horizontal" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>