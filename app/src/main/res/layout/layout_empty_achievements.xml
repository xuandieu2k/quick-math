    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_128"
        android:layout_marginTop="@dimen/dp_8"
        android:src="@drawable/ic_reward" />

</LinearLayout>